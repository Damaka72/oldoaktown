{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/approve-business",
      "destination": "/api/approve?kind=business"
    },
    {
      "source": "/api/approve-event",
      "destination": "/api/approve?kind=event"
    },
    {
      "source": "/api/approve-listing",
      "destination": "/api/approve?kind=listing"
    },
    {
      "source": "/api/instagram-feed",
      "destination": "/api/content?route=videos&ig=1"
    },
    {
      "source": "/api/get-businesses",
      "destination": "/api/content?route=get-businesses"
    },
    {
      "source": "/api/get-ticker-news",
      "destination": "/api/content?route=get-ticker-news"
    },
    {
      "source": "/api/image-search",
      "destination": "/api/content?route=image-search"
    },
    {
      "source": "/api/agent-data",
      "destination": "/api/content?route=agent-data"
    },
    {
      "source": "/api/videos",
      "destination": "/api/content?route=videos"
    },
    {
      "source": "/api/submit-business",
      "destination": "/api/submit?route=submit-business"
    },
    {
      "source": "/api/submit-event",
      "destination": "/api/submit?route=submit-event"
    },
    {
      "source": "/api/subscribe",
      "destination": "/api/submit?route=subscribe"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/generate-posts.js": {
      "maxDuration": 60
    },
    "api/buffer-post.js": {
      "maxDuration": 30
    },
    "api/content.js": {
      "maxDuration": 30,
      "includeFiles": "data/**"
    },
    "api/submit.js": {
      "maxDuration": 30
    }
  }
}
